<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:mapbox="http://schemas.android.com/tools"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <com.mapbox.services.android.navigation.ui.v5.NavigationView
        android:id="@+id/navigation_view_turn_by_turn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:navigationViewBannerBackground="@color/colorPrimary"
        app:itemTextColor="@android:color/white"
        app:navigationViewRouteStyle="@color/colorPrimaryLight"
        app:itemBackground="@color/colorPrimary"
        app:statusBarBackground="@color/colorPrimaryLight"
        app:navigationLightTheme="@style/NavigationViewLight"></com.mapbox.services.android.navigation.ui.v5.NavigationView>
</androidx.constraintlayout.widget.ConstraintLayout>