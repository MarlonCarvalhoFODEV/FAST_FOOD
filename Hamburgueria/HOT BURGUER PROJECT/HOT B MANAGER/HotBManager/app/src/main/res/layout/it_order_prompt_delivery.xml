<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="55dp">

    <RelativeLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="55dp">

        <TextView
            android:id="@+id/tv_count_it_order_prompt_delivery"
            android:text="0"
            android:gravity="center"
            android:paddingBottom="5dp"
            android:textSize="18dp"
            android:textColor="#FFFFFF"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:background="@color/colorPrimaryDark"/>

        <TextView
            android:text="Pedidos"
            android:textSize="10dp"
            android:textColor="#FFFFFF"
            android:gravity="center_horizontal|bottom"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:paddingBottom="5dp"/>

        <TextView
            android:id="@+id/tv_name_it_order_prompt_delivery"
            android:text="Deliveryman Name"
            android:textSize="16dp"
            android:textStyle="bold"
            android:layout_toRightOf="@+id/tv_count_it_order_prompt_delivery"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="50dp"
            android:lines="1"/>

        <TextView
            android:id="@+id/tv_ids_orders_it_prompt_delivery"
            android:text="Pedidos (000 • 000)"
            android:textSize="14dp"
            android:layout_toRightOf="@+id/tv_count_it_order_prompt_delivery"
            android:layout_marginLeft="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_name_it_order_prompt_delivery"
            android:layout_marginRight="38dp"/>

        <Button
            android:id="@+id/btn_notification_it_order_prompt_delivery"
            android:layout_alignParentRight="true"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_margin="8dp"
            android:background="@drawable/ic_notification_deliveryman" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#B8B8B8"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/rl_progress_it_prompt_delivery"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B9000000"
        android:visibility="gone"
        android:clickable="true">

        <ProgressBar
            android:id="@+id/pb_notification_it_prompt_delivery"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:indeterminateTint="@color/colorPrimaryDark"
            android:layout_centerVertical="true"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Re-notificando entregador..."
            android:textColor="#FFFFFF"
            android:layout_toRightOf="@+id/pb_notification_it_prompt_delivery"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
</FrameLayout>