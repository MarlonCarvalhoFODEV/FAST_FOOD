    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/sdv_it_photo_holding"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginRight="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_profile"
        app:roundingBorderWidth="0.8dp"
        app:roundingBorderColor="#a9a9a9"
        app:roundAsCircle="true"
        android:layout_centerVertical="true"
        android:layout_alignParentLeft="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_name_it_deliveryman"
        android:text="Deliveryman Name"
        android:textSize="18dp"
        android:textColor="#494949"
        android:textStyle="bold"
        android:layout_toRightOf="@+id/sdv_it_photo_holding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/tv_orders_it_deliveryman"
        android:text="Orders (000 • 000 • 000)"
        android:textSize="14dp"
        android:layout_toRightOf="@+id/sdv_it_photo_holding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_name_it_deliveryman"/>
</RelativeLayout>