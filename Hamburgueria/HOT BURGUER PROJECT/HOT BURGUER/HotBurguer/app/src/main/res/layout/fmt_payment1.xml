<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/back_black"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp">

            <TextView
                android:id="@+id/textView4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="Dados de Pagamento"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Número do Cartão"
                android:textColor="#DFDFDF"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView4" />

            <LinearLayout
                android:id="@+id/linearLayout"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:minHeight="50dp"
                android:maxHeight="50dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/rounded_edit_text"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@+id/tv_5"
                tools:layout_editor_absoluteX="16dp">

                <ImageView
                    android:id="@+id/iv_card_icon_neo"
                    android:layout_width="45dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="10dp"
                    android:src="@drawable/ic_card" />

                <EditText
                    android:id="@+id/et_card_number_neo"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_margin="4dp"
                    android:background="@android:color/white"
                    android:hint="**** **** **** ****"
                    android:inputType="number"
                    android:minHeight="50dp"
                    android:maxHeight="50dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Data de Validade"
                android:textColor="#DFDFDF"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/linearLayout" />

            <EditText
                android:id="@+id/et_card_valid_date_neo"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/rounded_edit_text"
                android:hint="Mês/ano"
                android:inputType="number"
                android:paddingLeft="16dp"
                android:minHeight="50dp"
                android:maxHeight="50dp"
                app:layout_constraintEnd_toStartOf="@+id/et_card_cvv_neo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="CVV"
                android:textColor="#DFDFDF"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/textView"
                app:layout_constraintTop_toBottomOf="@+id/linearLayout" />

            <EditText
                android:id="@+id/et_card_cvv_neo"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/rounded_edit_text"
                android:hint="***"
                android:inputType="number"
                android:paddingLeft="16dp"
                android:minHeight="50dp"
                android:maxHeight="50dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/textView2"
                app:layout_constraintTop_toBottomOf="@+id/textView2" />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Nome do Cartão"
                android:textColor="#DFDFDF"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/et_card_valid_date_neo" />

            <EditText
                android:id="@+id/et_card_name_neo"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/rounded_edit_text"
                android:hint="Joana S. Nascimento"
                android:inputType="textPersonName"
                android:maxHeight="50dp"
                android:minHeight="50dp"
                android:paddingLeft="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView3" />

            <TextView
                android:id="@+id/textView5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="CPF"
                android:textColor="#DFDFDF"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/et_card_name_neo" />

            <EditText
                android:id="@+id/et_cpf_fmt_payment"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/rounded_edit_text"
                android:hint="***.***.***-**"
                android:inputType="number"
                android:paddingLeft="16dp"
                android:minHeight="50dp"
                android:maxHeight="50dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView5" />

            <TextView
                android:id="@+id/textView6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Data de Nascimento"
                android:textColor="#DFDFDF"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/et_cpf_fmt_payment" />

            <EditText
                android:id="@+id/et_birth_of_date_fmt_payment"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/rounded_edit_text"
                android:hint="**/**/****"
                android:inputType="number"
                android:paddingLeft="16dp"
                android:minHeight="50dp"
                android:maxHeight="50dp"
                app:layout_constraintTop_toBottomOf="@+id/textView6"
                tools:layout_editor_absoluteX="16dp" />

            <TextView
                android:id="@+id/textView7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Celular"
                android:textColor="#DFDFDF"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/et_birth_of_date_fmt_payment" />

            <EditText
                android:id="@+id/et_cel_fmt_payment"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/rounded_edit_text"
                android:hint="(**) *****-****"
                android:inputType="number"
                android:paddingLeft="16dp"
                android:minHeight="50dp"
                android:maxHeight="50dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/textView4"
                app:layout_constraintTop_toBottomOf="@+id/textView7" />

            <Switch
                android:id="@+id/st_save_card_future_payment_neo"
                android:layout_width="360dp"
                android:layout_height="55dp"
                android:layout_margin="16dp"
                android:paddingRight="16dp"
                android:paddingLeft="16dp"
                android:layout_marginBottom="32dp"
                android:text="Salvar dados para futuros pagamentos"
                android:textColor="#DFDFDF"
                android:minHeight="55dp"
                android:maxHeight="55dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/et_cel_fmt_payment"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <RelativeLayout
        android:id="@+id/rl_base_card_selected"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clickable="false"
        android:padding="16dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_close_card_selected"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentEnd="true"
            android:background="@android:color/transparent"
            android:text="X"
            android:textColor="#FFFFFF"
            android:textSize="22dp" />

        <ImageView
            android:id="@+id/iv_card_brand_selected"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_above="@+id/tv_card_selected"
            android:layout_centerInParent="true"
            android:src="@drawable/ic_card" />

        <TextView
            android:id="@+id/tv_card_selected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/tv_card_description_selected"
            android:gravity="center_horizontal"
            android:text="CARTÃO DE CRÉDITO SELECIONADO"
            android:textColor="#EAEAEA"
            android:textSize="16dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_card_description_selected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center_horizontal"
            android:text="BRAND CARD • **** 4589"
            android:textColor="#EAEAEA"
            android:textSize="22dp"
            android:textStyle="bold" />
    </RelativeLayout>
</FrameLayout>