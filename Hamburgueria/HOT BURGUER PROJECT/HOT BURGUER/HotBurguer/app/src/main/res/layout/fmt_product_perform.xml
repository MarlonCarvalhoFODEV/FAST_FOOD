<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:minHeight="300dp"
    android:orientation="vertical"
    android:background="#000000"
    android:paddingLeft="32dp"
    android:paddingRight="32dp">

    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/sdvImage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/back_decor_product"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        fresco:actualImageScaleType="fitCenter"
        fresco:fadeDuration="300"
        fresco:failureImage="@drawable/ic_img_fail"
        fresco:failureImageScaleType="centerInside"
        fresco:layout_constraintBottom_toTopOf="@+id/tv_cif"
        fresco:layout_constraintEnd_toEndOf="parent"
        fresco:layout_constraintStart_toStartOf="parent"
        fresco:layout_constraintTop_toTopOf="parent"
        fresco:placeholderImage="@drawable/ic_other_img"
        fresco:placeholderImageScaleType="fitCenter"
        fresco:progressBarAutoRotateInterval="1000"
        fresco:progressBarImageScaleType="centerInside"
        fresco:retryImageScaleType="centerCrop" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rl_progress_product"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="32dp"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        android:elevation="0dp">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:indeterminateTint="@color/colorPrimaryDark"
            fresco:layout_constraintBottom_toBottomOf="parent"
            fresco:layout_constraintEnd_toEndOf="parent"
            fresco:layout_constraintStart_toStartOf="parent"
            fresco:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tv_title_product"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:background="#000000"
        android:fontFamily="@font/daypbl"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:text="SIMPLES DUPLO"
        android:textColor="#FFFFFF"
        android:textSize="25dp"
        fresco:layout_constraintEnd_toEndOf="parent"
        fresco:layout_constraintStart_toStartOf="parent"
        fresco:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="32dp"
        android:background="#000000"
        fresco:layout_constraintBottom_toTopOf="@+id/tv_engagement"
        fresco:layout_constraintEnd_toEndOf="parent"
        fresco:layout_constraintStart_toStartOf="@+id/tv_cif" />

    <TextView
        android:id="@+id/tv_cif"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="8dp"
        android:background="#000000"
        android:elevation="2dp"
        android:fontFamily="@font/babyu"
        android:paddingLeft="12dp"
        android:text="R$"
        android:textColor="#FFFFFF"
        android:textSize="30dp"
        fresco:layout_constraintBottom_toBottomOf="@+id/tv_firs_number_price_product"
        fresco:layout_constraintEnd_toStartOf="@+id/tv_firs_number_price_product"
        fresco:layout_constraintHorizontal_bias="1.0"
        fresco:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_firs_number_price_product"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="52dp"
        android:elevation="2dp"
        android:fontFamily="@font/babyu"
        android:gravity="bottom"
        android:paddingLeft="8dp"
        android:text="12"
        android:textColor="#FFFFFF"
        android:textSize="80dp"
        fresco:layout_constraintBottom_toTopOf="@+id/tv_engagement"
        fresco:layout_constraintEnd_toEndOf="parent"
        fresco:layout_constraintHorizontal_bias="1.0"
        fresco:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_decimal_price_product"
        android:layout_width="wrap_content"
        android:layout_height="65dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="32dp"
        android:background="#000000"
        android:elevation="4dp"
        android:fontFamily="@font/babyu"
        android:gravity="bottom"
        android:paddingRight="12dp"
        android:text=",99"
        android:textColor="#FFFFFF"
        android:textSize="25dp"
        fresco:layout_constraintBottom_toBottomOf="@+id/tv_firs_number_price_product"
        fresco:layout_constraintStart_toEndOf="@+id/tv_firs_number_price_product" />

    <ToggleButton
        android:id="@+id/btn_like_product"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_weight="1"
        android:background="@drawable/ic_favorite"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="25dp"
        android:textOff=" "
        android:textOn=" "
        android:text=" "
        fresco:layout_constraintBottom_toTopOf="@+id/tv_engagement"
        fresco:layout_constraintStart_toStartOf="parent"
        fresco:layout_constraintTop_toBottomOf="@+id/sdvImage"
        fresco:layout_constraintVertical_bias="1.0" />

    <Button
        android:id="@+id/btn_feedback_product"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:background="@drawable/ic_feedback"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="25dp"
        fresco:layout_constraintBottom_toTopOf="@+id/tv_engagement"
        fresco:layout_constraintStart_toEndOf="@+id/btn_like_product"
        fresco:layout_constraintTop_toBottomOf="@+id/sdvImage"
        fresco:layout_constraintVertical_bias="1.0" />

    <TextView
        android:id="@+id/tv_engagement"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_weight="0.8"
        android:gravity="center"
        android:text="38 curtidas e 150 comentários"
        android:textColor="#FFFFFF"
        android:textSize="14dp"
        fresco:layout_constraintBottom_toTopOf="@+id/constraintLayout"
        fresco:layout_constraintStart_toStartOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        fresco:layout_constraintBottom_toBottomOf="parent"
        fresco:layout_constraintEnd_toEndOf="parent"
        fresco:layout_constraintHorizontal_bias="1.0"
        fresco:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btn_anyless_product"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="-"
            android:textColor="#FFFFFF"
            android:textSize="25dp"
            android:layout_marginRight="16dp"
            fresco:layout_constraintBottom_toBottomOf="parent"
            fresco:layout_constraintStart_toStartOf="parent"
            fresco:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_count_product"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:gravity="center"
            android:text="0un"
            android:textColor="#FFFFFF"
            android:textSize="30dp"
            fresco:layout_constraintBottom_toBottomOf="parent"
            fresco:layout_constraintEnd_toStartOf="@+id/btn_more_product"
            fresco:layout_constraintStart_toEndOf="@+id/btn_anyless_product"
            fresco:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/btn_more_product"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_weight="1"
            android:background="@drawable/back_btn_more"
            android:gravity="center"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="25dp"
            fresco:layout_constraintBottom_toBottomOf="parent"
            fresco:layout_constraintEnd_toEndOf="parent"
            fresco:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>