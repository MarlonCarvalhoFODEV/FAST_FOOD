<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="40dp"
    app:cardCornerRadius="5dp"
    app:cardElevation="2dp"
    app:cardMaxElevation="2dp"
    app:cardPreventCornerOverlap="true"
    app:cardUseCompatPadding="false">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_title_dg_del"
            android:text="Deseja excluir o item"
            android:textSize="20dp"
            android:textColor="@color/colorBlack"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"/>

        <TextView
            android:id="@+id/dg_del_tv_product_name"
            android:text="Product Name"
            android:textColor="@color/colorTbTitle"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_below="@+id/tv_title_dg_del"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_below="@+id/dg_del_tv_product_name"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/dg_del_btn_not"
                android:text="Não"
                android:textColor="@color/colorPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/dg_del_tv_product_name"
                android:layout_marginTop="20dp"
                android:layout_weight="0.000000000001"
                android:background="@color/transparente"/>

            <Button
                android:id="@+id/dg_del_btn_yes"
                android:text="Sim"
                android:textColor="@color/colorAccent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/dg_del_tv_product_name"
                android:layout_marginTop="20dp"
                android:layout_weight="0.000000000001"
                android:background="@color/transparente"/>
        </LinearLayout>

    </RelativeLayout>
</androidx.cardview.widget.CardView>