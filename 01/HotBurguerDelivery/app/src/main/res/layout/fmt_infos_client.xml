<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tv_contact_infos_client"
        android:text="Contato"
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@android:color/primary_text_light"
        android:layout_marginTop="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/tv_cel_infos_client"
        android:text="Cel (21) 90000-0000"
        android:textSize="16dp"
        android:textColor="@android:color/secondary_text_light"
        android:layout_marginTop="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_contact_infos_client"/>

    <TextView
        android:id="@+id/tv_collection_infos_client"
        android:text="Cobrança"
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@android:color/primary_text_light"
        android:layout_marginTop="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_cel_infos_client"/>

    <TextView
        android:id="@+id/tv_value_infos_client"
        android:text="R$ 0,00"
        android:textSize="25dp"
        android:textColor="@android:color/secondary_text_light"
        android:layout_marginTop="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_collection_infos_client"/>

    <TextView
        android:id="@+id/tv_ad_infos_client"
        android:text="Endereço"
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@android:color/primary_text_light"
        android:layout_marginTop="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_value_infos_client"/>

    <TextView
        android:id="@+id/tv_address_infos_client"
        android:text="Rua"
        android:textSize="18dp"
        android:textColor="@android:color/secondary_text_light"
        android:layout_marginTop="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_ad_infos_client"/>
</RelativeLayout>