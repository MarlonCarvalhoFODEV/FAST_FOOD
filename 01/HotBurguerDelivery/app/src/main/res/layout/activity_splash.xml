<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".acitivtys.a1_splash.SplashActivity"
    android:background="@drawable/back_principal"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        tools:layout_editor_absoluteX="122dp"
        tools:layout_editor_absoluteY="162dp"
        tools:srcCompat="@drawable/ic_helmet"

        android:layout_centerInParent="true"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:text="HOT B. Delivery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="28dp"
        android:textColor="#F1592A"
        android:fontFamily="@font/aardc"/>
</LinearLayout>