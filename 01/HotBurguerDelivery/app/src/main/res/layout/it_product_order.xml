<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="4dp"
    app:cardElevation="1dp"
    app:cardMaxElevation="1dp"
    app:cardUseCompatPadding="false"
    app:cardPreventCornerOverlap="true">


    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="50dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_img_order_products"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:layout_marginRight="10dp"/>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/tv_it_count_product"
            android:layout_centerVertical="true"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:layout_weight="0.000000001">
            <TextView
                android:id="@+id/tv_it_name_product"
                android:text="name"
                android:textColor="@android:color/primary_text_light"
                android:textSize="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="40dp"
                android:layout_toRightOf="@+id/tv_it_count_product"/>

            <TextView
                android:id="@+id/tv_it_price_product"
                android:text="name"
                android:textSize="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/tv_it_count_product"
                android:layout_below="@+id/tv_it_name_product"/>
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/base_it_product_order"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@color/transparentePreto">

            <TextView
                android:id="@+id/tv_it_count_product"
                android:text="20x"
                android:textColor="@color/colorWhite"
                android:textStyle="bold"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:layout_marginRight="0dp"
                android:layout_centerVertical="true"
                android:layout_gravity="right"
                android:visibility="visible"/>

            <CheckBox
                android:id="@+id/cb_check_product"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginRight="10dp"
                android:theme="@style/AppTheme.AppBarOverlay"
                android:layout_toRightOf="@+id/tv_it_count_product"/>
        </RelativeLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>